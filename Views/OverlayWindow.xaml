<Window x:Class="Museek.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Museek" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Manual" ShowActivated="False"
        Width="432" Height="690" MinWidth="360" MinHeight="470"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Theme brushes (re-assigned from code in ApplyTheme) -->
        <SolidColorBrush x:Key="Panel" Color="#E00F172A"/>
        <SolidColorBrush x:Key="TitleBar" Color="#660F172A"/>
        <SolidColorBrush x:Key="FooterBar" Color="#B30F172A"/>
        <SolidColorBrush x:Key="Card" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Fg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="FgDim" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="FgFaint" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#338B5CF6"/>
        <SolidColorBrush x:Key="Cyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="Pink" Color="#EC4899"/>
        <Color x:Key="AccentColor">#8B5CF6</Color>
        <SolidColorBrush x:Key="PlayFill" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="PlayGlyph" Color="White"/>
        <SolidColorBrush x:Key="PlayBorder" Color="Transparent"/>
        <Thickness x:Key="PlayBorderThickness">0</Thickness>
        <CornerRadius x:Key="PlayCornerRadius">26</CornerRadius>
        <CornerRadius x:Key="CardRadius">12</CornerRadius>
        <CornerRadius x:Key="ControlRadius">12</CornerRadius>

        <LinearGradientBrush x:Key="PurpleCyan" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurplePink" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== Icon button ===== -->
        <Style x:Key="GlyphBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Big gradient play button ===== -->
        <Style x:Key="PlayBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource PlayGlyph}"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Width="66" Height="66" Fill="{DynamicResource AccentSoft}" Opacity="{DynamicResource PlayGlowOpacity}"/>
                            <Border CornerRadius="{DynamicResource PlayCornerRadius}" Background="{DynamicResource PlayFill}"
                                    BorderBrush="{DynamicResource PlayBorder}" BorderThickness="{DynamicResource PlayBorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.07" ScaleY="1.07"/></Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Tab button ===== -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="0,10,0,9" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Small text button ===== -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}" Opacity="0.85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Glass text box ===== -->
        <Style x:Key="GlassBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Card}" CornerRadius="{DynamicResource ControlRadius}"
                                BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Slim scrollbar ===== -->
        <Style x:Key="ScrollNoBg" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollNoBg}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollNoBg}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#44FFFFFF" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Glass slider ===== -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Height="18" Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#55475569" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White" Stroke="#33000000" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Preset chip ===== -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="12" Padding="11,4" Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toggle switch ===== -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#55475569">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Data templates ===== -->
        <DataTemplate x:Key="QueueTemplate">
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Index}" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtUrl}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" FontSize="10.5"
                                   Foreground="{DynamicResource FgFaint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Duration}" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LyricTemplate">
            <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="14" Margin="0,6" Cursor="Hand" Opacity="0.55"
                       Foreground="{DynamicResource FgDim}" MouseLeftButtonUp="Lyric_Click"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Cyan}"/>
                    <Setter TargetName="T" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="T" Property="FontSize" Value="16"/>
                    <Setter TargetName="T" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 16px transparent margin leaves room for the fake shadow -->
    <Grid x:Name="RootGrid" Margin="16">
        <!-- cheap fake shadow: translucent rounded rects instead of a blur effect (far less CPU) -->
        <Border x:Name="ShadowOuter" CornerRadius="28" Background="#12000000" Margin="-5,-2,-5,-9"/>
        <Border x:Name="ShadowCaster" CornerRadius="25" Background="#22000000" Margin="-2,0,-2,-4"/>

        <Border x:Name="PanelBorder" CornerRadius="24" Background="{DynamicResource Panel}"
                BorderThickness="1" BorderBrush="#1FFFFFFF">
            <Grid x:Name="ContentRoot">
                <!-- ambient glow tinted from the album art -->
                <Border x:Name="GlowLayer" CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.28,0.12" GradientOrigin="0.28,0.12" RadiusX="0.75" RadiusY="0.55">
                            <GradientStop x:Name="GlowCenter" Color="#668B5CF6" Offset="0"/>
                            <GradientStop x:Name="GlowEdge" Color="#008B5CF6" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid x:Name="MainGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ============ TITLE BAR / DRAG HANDLE ============ -->
                    <Border x:Name="TitleBarBorder" Grid.Row="0" Height="40" Background="{DynamicResource TitleBar}"
                            CornerRadius="24,24,0,0" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF">
                        <DockPanel Margin="16,0,10,0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotClose" Width="12" Height="12" Fill="#CCEF4444" Margin="0,0,8,0"
                                         Cursor="Hand" ToolTip="Hide overlay" MouseLeftButtonUp="DotClose_Click"/>
                                <Ellipse x:Name="DotCompact" Width="12" Height="12" Fill="#CCEAB308" Margin="0,0,8,0"
                                         Cursor="Hand" ToolTip="Shrink to mini view" MouseLeftButtonUp="DotCompact_Click"/>
                                <Ellipse x:Name="DotExpand" Width="12" Height="12" Fill="#CC22C55E" Margin="0,0,12,0"
                                         Cursor="Hand" ToolTip="Full view" MouseLeftButtonUp="DotExpand_Click"/>
                                <TextBlock Text="♫" Foreground="{DynamicResource Accent}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="MUSEEK" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="1" CornerRadius="5" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="OVERLAY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MicBtn" Style="{StaticResource GlyphBtn}" Content="&#xE720;"
                                        FontSize="12" Width="28" Height="28" ToolTip="Voice commands" Click="Mic_Click"/>
                                <Button x:Name="LockBtn" Style="{StaticResource GlyphBtn}" Content="&#xE785;"
                                        FontSize="12" Width="28" Height="28" ToolTip="Lock (click-through)" Click="Lock_Click"/>
                                <Button x:Name="PinBtn" Style="{StaticResource GlyphBtn}" Content="&#xE718;"
                                        FontSize="12" Width="28" Height="28" ToolTip="Always on top" Click="Pin_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    
                    <!-- ============ NOW PLAYING ============ -->
                    <Border x:Name="NowPlayingBorder" Grid.Row="1" Padding="20,18,20,12" Background="Transparent">
                        <StackPanel>
                            <Grid x:Name="InfoRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ArtHost" Width="84" Height="84" Margin="0,0,16,0">
                                    <Border x:Name="ArtBorder" CornerRadius="16" Background="#33808080"
                                            BorderThickness="1" BorderBrush="#33FFFFFF"/>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Accent}"
                                            BorderBrush="#4DFFFFFF" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                                        <TextBlock x:Name="ArtBadge" Text="♪" FontSize="12" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border x:Name="NowPlayingPill" HorizontalAlignment="Left" CornerRadius="10"
                                            Background="#1A06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" Padding="8,1">
                                        <TextBlock Text="NOW PLAYING" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Cyan}"/>
                                    </Border>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="LikeBtn" Grid.Column="1" Style="{StaticResource GlyphBtn}"
                                                Content="&#xEB51;" Width="28" Height="28" ToolTip="Like" Click="Like_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="ArtistText" FontSize="13.5" Foreground="{DynamicResource FgDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AlbumText" FontSize="11.5" Foreground="{DynamicResource FgFaint}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="ProgressBlock">
                                <Grid x:Name="ProgressHost" Height="8" Margin="0,18,0,0" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonUp="Progress_MouseLeftButtonUp"
                                      MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave">
                                    <Border x:Name="ProgressTrack" CornerRadius="4" Background="#99334155"/>
                                    <Border x:Name="ProgressFill" CornerRadius="4" Background="{DynamicResource PurpleCyan}"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Ellipse x:Name="ProgressHandle" Width="14" Height="14" Fill="White" Opacity="0"
                                             HorizontalAlignment="Left" Margin="-7,-3,0,0" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="HandleShift" X="0"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <Grid x:Name="TimeRow" Margin="0,5,0,0">
                                    <TextBlock x:Name="CurTimeText" Text="0:00" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="DurTimeText" Text="0:00" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <Grid x:Name="ControlsGrid" Margin="8,6,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ShuffleBtn" Style="{StaticResource GlyphBtn}" Content="&#xE8B1;"
                                        HorizontalAlignment="Left" ToolTip="Shuffle" Click="Shuffle_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PrevBtn" Style="{StaticResource GlyphBtn}" Content="&#xE892;"
                                            FontSize="18" Width="40" Height="40" Margin="0,0,10,0" ToolTip="Previous" Click="Prev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource PlayBtnStyle}" Content="&#xE768;"
                                            ToolTip="Play / pause" Click="Play_Click"/>
                                    <Button x:Name="NextBtn" Style="{StaticResource GlyphBtn}" Content="&#xE893;"
                                            FontSize="18" Width="40" Height="40" Margin="10,0,0,0" ToolTip="Next" Click="Next_Click"/>
                                </StackPanel>
                                <Button x:Name="RepeatBtn" Grid.Column="2" Style="{StaticResource GlyphBtn}" Content="&#xE8EE;"
                                        HorizontalAlignment="Right" ToolTip="Repeat" Click="Repeat_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ============ TABS ============ -->
                    <StackPanel x:Name="TabsHost" Grid.Row="2">
                        <UniformGrid x:Name="TabsRow" Columns="5" Background="{DynamicResource TitleBar}">
                            <RadioButton x:Name="TabQueue" GroupName="tabs" Tag="queue" Content="Up Next" Style="{StaticResource TabBtn}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabLyrics" GroupName="tabs" Tag="lyrics" Content="Lyrics" Style="{StaticResource TabBtn}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabChat" GroupName="tabs" Tag="chat" Content="Chat" Style="{StaticResource TabBtn}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabVisuals" GroupName="tabs" Tag="visuals" Content="Visuals" Style="{StaticResource TabBtn}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabSettings" GroupName="tabs" Tag="settings" Content="Customize" Style="{StaticResource TabBtn}" Checked="Tab_Checked"/>
                        </UniformGrid>
                        <Border Height="1" Background="#1AFFFFFF"/>
                    </StackPanel>

                    <!-- ============ TAB CONTENT (flexes with the window) ============ -->
                    <Grid x:Name="TabContent" Grid.Row="3" Margin="16,14,16,12" ClipToBounds="True">
                        <!-- UP NEXT -->
                        <Grid x:Name="PanelQueue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="QueueAddRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AddTrackInput" Style="{StaticResource GlassBox}"
                                         PreviewMouseDown="Input_PreviewMouseDown" LostKeyboardFocus="Input_LostFocus"
                                         KeyDown="AddTrackInput_KeyDown" ToolTip="Search for a song and add it to your Spotify queue"/>
                                <Button Grid.Column="1" Style="{StaticResource PillBtn}" Content="+ Add"
                                        Margin="8,0,0,0" Click="AddTrack_Click"/>
                            </Grid>
                            <Grid x:Name="QueueHeaderRow" Grid.Row="1" Margin="0,12,0,8">
                                <TextBlock Text="PLAYING NEXT" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgFaint}"/>
                                <TextBlock x:Name="QueueStatus" FontSize="10.5" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Cyan}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueTemplate}"/>
                                    <TextBlock x:Name="QueueEmpty" Text="The queue is empty." FontSize="12"
                                               Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- LYRICS -->
                        <Grid x:Name="PanelLyrics" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="⚡ Auto-synced lyrics" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Pink}" VerticalAlignment="Center"/>
                                <Button x:Name="AutoScrollBtn" Content="Auto-scroll: ON" Style="{StaticResource PillBtn}"
                                        FontSize="10" Padding="10,3" HorizontalAlignment="Right" Click="AutoScroll_Click"/>
                            </Grid>
                            <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="LyricsStatus" Text="Nothing playing." FontSize="12"
                                               Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                                    <ItemsControl x:Name="LyricsList" ItemTemplate="{StaticResource LyricTemplate}" Margin="0,60"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- CHAT -->
                        <Grid x:Name="PanelChat" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="12,10">
                                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="ChatLog" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                               Foreground="{DynamicResource Fg}"
                                               Text="Ask me anything about the song, the artist, or for recommendations ✨"/>
                                </ScrollViewer>
                            </Border>
                            <TextBox x:Name="ChatInput" Grid.Row="1" Style="{StaticResource GlassBox}" Margin="0,10,0,0"
                                     KeyDown="ChatInput_KeyDown" PreviewMouseDown="Input_PreviewMouseDown"
                                     LostKeyboardFocus="Input_LostFocus" ToolTip="Press Enter to send"/>
                        </Grid>

                        <!-- VISUALS -->
                        <ScrollViewer x:Name="PanelVisuals" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#99020617" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Animated spectrum" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <TextBlock Text="decorative" FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="#94A3B8"/>
                                        </Grid>
                                        <Canvas x:Name="VizCanvas" Height="64" ClipToBounds="True"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="VolumeCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14,10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Volume" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                                            <TextBlock x:Name="VolVal" Text="—" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="VolumeSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                                                Margin="0,6,0,0" ValueChanged="VolumeSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="VolumeSlider_MouseDown"
                                                PreviewMouseLeftButtonUp="VolumeSlider_MouseUp"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14,10" Margin="0,10,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Sound preset" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                                            <TextBlock Text="system-wide · Equalizer APO" FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource FgFaint}"/>
                                        </Grid>
                                        <WrapPanel x:Name="EqChips" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="EqStatus" FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource FgFaint}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- CUSTOMIZE (built in code) -->
                        <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CustomizeHost"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ FOOTER ============ -->
                    <Border x:Name="FooterBorder" Grid.Row="4" Background="{DynamicResource FooterBar}" CornerRadius="0,0,24,24"
                            BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF" Padding="16,9,30,9">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="Connecting…" FontSize="11" Foreground="{DynamicResource FgFaint}"/>
                            </StackPanel>
                            <TextBlock x:Name="CustomizeLink" Text="Customize" FontSize="11" Cursor="Hand"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"
                                       MouseLeftButtonUp="CustomizeLink_Click"/>
                        </Grid>
                    </Border>

                    <!-- ============ FIRST-RUN TOUR (hidden until started) ============ -->
                    <Grid x:Name="TourLayer" Grid.RowSpan="5" Visibility="Collapsed" Background="#D9000000">
                        <Border Margin="22" Padding="22,18,22,18" CornerRadius="16" VerticalAlignment="Center"
                                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TourStep" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                <TextBlock x:Name="TourTitle" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Fg}"
                                           TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock x:Name="TourBody" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"/>
                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="Skip tour" FontSize="11.5" Cursor="Hand" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FgFaint}" MouseLeftButtonUp="TourSkip_Click"/>
                                    <Button x:Name="TourNext" Content="Next" Style="{StaticResource PillBtn}"
                                            HorizontalAlignment="Right" Click="TourNext_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- visual hint for the resize zone (the real hit zones are added in code, on all 8 edges/corners) -->
        <Path x:Name="GripGlyph" Data="M 12,2 L 12,12 L 2,12 Z" Fill="#66FFFFFF" Width="14" Height="14" Stretch="Fill"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6" IsHitTestVisible="False"/>
    </Grid>
</Window>
